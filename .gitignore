# Hymn material is copyrighted and never committed: each developer downloads the PDFs and
# recordings themselves (see README). The folders stay so the app build finds them.
hymns/pdf/*
hymns/json/*
hymns/beatmaps/*
hymns/audio/*
!hymns/*/.gitkeep
/build/
recordings/
